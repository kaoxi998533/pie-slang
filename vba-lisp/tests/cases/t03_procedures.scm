(define (make-counter)
  (let ((n 0))
    (lambda () (set! n (+ n 1)) n)))
(define c (make-counter))
(c) (c)
(display (c)) (newline)
(define (even2? n) (if (= n 0) #t (odd2? (- n 1))))
(define (odd2? n) (if (= n 0) #f (even2? (- n 1))))
(display (even2? 3001)) (newline)
(define (f . args) args)
(display (f 1 2 3)) (newline)
(define (h a . rest) (list a rest))
(display (h 1)) (display (h 1 2 3)) (newline)
(display ((lambda (x y) (+ x y)) 3 4)) (newline)
(display (let* ((x 1) (y (+ x 1))) (* x y))) (newline)
(display (letrec ((fact (lambda (n) (if (= n 0) 1 (* n (fact (- n 1))))))) (fact 10))) (newline)
(define compose (lambda (f g) (lambda (x) (f (g x)))))
(display ((compose (lambda (x) (* x 2)) (lambda (x) (+ x 1))) 5)) (newline)
(define (curry f x) (lambda (y) (f x y)))
(display (map (curry * 3) '(1 2 3))) (newline)
(define x 10)
(define (show-x) x)
(let ((x 20)) (display (show-x))) (newline)
(display (do ((i 0 (+ i 1)) (acc '() (cons i acc))) ((= i 4) acc))) (newline)
(define add (case-lambda ((a) a) ((a b) (+ a b)) ((a . rest) (apply + a rest))))
(display (list (add 1) (add 1 2) (add 1 2 3))) (newline)
(call-with-values (lambda () (values 1 2)) (lambda (a b) (display (+ a b)) (newline)))
(let-values (((a b) (values 1 2)) ((c) (values 3))) (display (list a b c)) (newline))
(define-values (u v) (values 'x 'y)) (display (list u v)) (newline)
(define (tree-sum t) (cond ((null? t) 0) ((pair? t) (+ (tree-sum (car t)) (tree-sum (cdr t)))) (else t)))
(display (tree-sum '(1 (2 3) (4 (5))))) (newline)
(display (procedure? car)) (display (procedure? 'car)) (display (procedure? (lambda () 1))) (newline)
(define fns (map (lambda (i) (lambda () i)) '(1 2 3)))
(display (map (lambda (f) (f)) fns)) (newline)
(define (deep n) (if (= n 0) 0 (+ 1 (deep (- n 1)))))
(display (deep 500)) (newline)
(define (count-up n) (define (helper i acc) (if (> i n) (reverse acc) (helper (+ i 1) (cons i acc)))) (helper 1 '()))
(display (count-up 5)) (newline)
(define (apply-twice f x) (f (f x)))
(display (apply-twice (lambda (s) (string-append s "!")) "hi")) (newline)
(display (let loop ((i 0)) (if (< i 2500) (loop (+ i 1)) i))) (newline)
(define g (lambda args (length args)))
(display (list (g) (g 1 2) (apply g '(1 2 3)))) (newline)
(define (adder n) (lambda (x) (+ x n)))
(define add5 (adder 5))
(display (map add5 '(1 2))) (newline)
(define counter 0)
(define (bump!) (set! counter (+ counter 1)) counter)
(bump!) (bump!)
