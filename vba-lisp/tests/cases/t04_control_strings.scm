(define (classify n)
  (cond ((< n 0) 'negative) ((= n 0) 'zero) ((< n 10) 'small) (else 'big)))
(display (map classify '(-5 0 5 50))) (newline)
(display (cond ((assv 2 '((1 . one) (2 . two))) => cdr) (else 'none))) (newline)
(define (kind c) (case c ((#\a #\e #\i #\o #\u) 'vowel) ((#\space) 'space) (else 'consonant)))
(display (map kind (string->list "hi a"))) (newline)
(display (case 5 ((1 2 3) 'low) ((4 5 6) 'mid) (else 'high))) (newline)
(display (list (and 1 2 3) (and) (and 1 #f 3) (or #f 2) (or) (or #f #f))) (newline)
(when (> 3 2) (display "yes") (newline))
(unless (> 3 2) (display "no") (newline))
(display (list (if '() 'true 'false) (if 0 'true 'false) (not 0) (not #f))) (newline)
