(define-syntax swap!
  (syntax-rules ()
    ((_ a b) (let ((tmp a)) (set! a b) (set! b tmp)))))
(define x 1) (define y 2)
(swap! x y)
(display (list x y)) (newline)
(define tmp 5) (define other 6)
(swap! tmp other)
(display (list tmp other)) (newline)
(define-syntax my-or
  (syntax-rules ()
    ((_) #f)
    ((_ e) e)
    ((_ e r ...) (let ((t e)) (if t t (my-or r ...))))))
(define t 7)
(display (list (my-or #f t) (my-or #f #f) (my-or) (my-or 1 (car '()))))
(newline)
(define-syntax my-let*
  (syntax-rules ()
    ((_ () body ...) (let () body ...))
    ((_ ((n v) rest ...) body ...) (let ((n v)) (my-let* (rest ...) body ...)))))
(display (my-let* ((a 1) (b (+ a 1))) (* a b 10))) (newline)
(define-syntax while
  (syntax-rules ()
    ((_ cond body ...) (let loop () (when cond body ... (loop))))))
(define i 0)
(while (< i 3) (display i) (set! i (+ i 1)))
(newline)
(define-syntax for
  (syntax-rules (in)
    ((_ x in lst body ...) (for-each (lambda (x) body ...) lst))))
(for v in '(a b c) (display v) (display " "))
(newline)
(define-syntax pairs
  (syntax-rules ()
    ((_ (a b) ...) (list (cons a b) ...))))
(display (pairs (1 2) (3 4))) (newline)
(define-macro (unless2 c . body) `(if ,c #f (begin ,@body)))
(display (unless2 #f 'ran)) (newline)
(define-macro (inc! v) `(set! ,v (+ ,v 1)))
(define n 10) (inc! n) (inc! n) (display n) (newline)
(define-syntax ten (syntax-rules () ((_) 10)))
(display (+ (ten) 1)) (newline)
(define (use-many) (let ((s 0)) (do ((k 0 (+ k 1))) ((= k 5) s) (set! s (+ s (ten))))))
(display (use-many)) (newline)
(define-syntax nested
  (syntax-rules ()
    ((_ (name val ...) ...) '((name (val ...)) ...))))
(display (nested (a 1 2) (b 3))) (newline)
(define-syntax my-if
  (syntax-rules (then else)
    ((_ c then t1 else e1) (if c t1 e1))))
(display (my-if #f then 'yes else 'no)) (newline)
(define-syntax unless3 (syntax-rules () ((_ c body ...) (if c #f (begin body ...)))))
(define loop 'user-loop)
(define k2 0)
(while (< k2 2) (set! k2 (+ k2 1)))
(display (list loop k2)) (newline)
(defmacro square-it (x) `(* ,x ,x))
(display (square-it 7)) (newline)
