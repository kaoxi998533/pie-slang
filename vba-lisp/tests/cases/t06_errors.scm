(define (safe-div a b)
  (guard (e (#t (display "error: ") (display (condition/report-string e)) (newline) #f))
    (/ a b)))
(display (safe-div 10 2)) (newline)
(safe-div 1 0)
(display (guard (e ((symbol? e) (list 'sym e)) ((string? e) (list 'str e))) (raise 'oops))) (newline)
(display (guard (e ((string? e) e)) (raise "boom"))) (newline)
(display (guard (e ((error-object? e) (error-object-message e))) (error "bad thing" 1 2))) (newline)
(display (guard (e ((error-object? e) (error-object-irritants e))) (error "bad thing" 1 2))) (newline)
(display (guard (e (else 'caught)) (car '()))) (newline)
(display (guard (e (#t (condition/report-string e))) (vector-ref (vector 1 2) 5))) (newline)
(display (guard (e (#t (condition/report-string e))) (undefined-fn 1))) (newline)
(display (guard (e (#t (condition/report-string e))) ((lambda (x) x)))) (newline)
(display (guard (e (#t (condition/report-string e))) (car 5))) (newline)
(display (guard (e (#t (condition/report-string e))) (error 'my-proc "went wrong:" 42))) (newline)
(display (call/cc (lambda (k) (for-each (lambda (x) (if (negative? x) (k x))) '(1 2 -3 4)) 'none))) (newline)
(define (find-first pred lst)
  (call-with-current-continuation
    (lambda (return)
      (for-each (lambda (x) (when (pred x) (return x))) lst)
      #f)))
(display (list (find-first even? '(1 3 4 5)) (find-first even? '(1 3)))) (newline)
(display (with-exception-handler (lambda (e) 'handled) (lambda () (raise 'x)))) (newline)
(dynamic-wind (lambda () (display "[in]")) (lambda () (display "body")) (lambda () (display "[out]"))) (newline)
(display (guard (e (#t 'outer)) (dynamic-wind (lambda () (display "<")) (lambda () (error "x")) (lambda () (display ">"))))) (newline)
(define (check x) (assert (> x 0)) x)
(display (guard (e (#t (condition/report-string e))) (check -1))) (newline)
(display (guard (e ((number? e) (* e 2))) (+ 1 (raise 21)))) (newline)
(guard (e (#f 'never)) (display "no error")) (newline)
(display (guard (e (#t (list 'reraised (condition/report-string e)))) (guard (e2 ((string? e2) 'inner)) (error "deep")))) (newline)
(display (guard (e (#t (condition/report-string e))) (+ 1 "a"))) (newline)
(define (deep n) (if (= n 0) 0 (+ 1 (deep (- n 1)))))
(display (guard (e (#t (condition/report-string e))) (deep 5000))) (newline)
(display (deep 100)) (newline)
(display (call/cc (lambda (k) (dynamic-wind (lambda () (display "a")) (lambda () (k 'escaped)) (lambda () (display "b")))))) (newline)
