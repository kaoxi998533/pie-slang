(define (qsort l)
  (if (null? l) '()
      (let ((p (car l)) (rest (cdr l)))
        (append (qsort (filter (lambda (x) (< x p)) rest))
                (list p)
                (qsort (filter (lambda (x) (>= x p)) rest))))))
(display (qsort '(3 1 4 1 5 9 2 6 5 3 5))) (newline)
(define (fib n) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))
(display (fib 15)) (newline)
(define (primes n)
  (let loop ((i 2) (acc '()))
    (cond ((> i n) (reverse acc))
          ((any (lambda (p) (= 0 (remainder i p))) acc) (loop (+ i 1) acc))
          (else (loop (+ i 1) (cons i acc))))))
(display (primes 50)) (newline)
(define (hanoi n from to via) (if (= n 0) 0 (+ (hanoi (- n 1) from via to) 1 (hanoi (- n 1) via to from))))
(display (hanoi 8 'a 'c 'b)) (newline)
(define (flatten x) (cond ((null? x) '()) ((pair? x) (append (flatten (car x)) (flatten (cdr x)))) (else (list x))))
(display (flatten '(1 (2 (3 4)) ((5))))) (newline)
(define (string-rev s) (list->string (reverse (string->list s))))
(display (string-rev "racecar")) (display (equal? "racecar" (string-rev "racecar"))) (newline)
(define (permutations l)
  (if (null? l) '(())
      (append-map (lambda (x) (map (lambda (p) (cons x p)) (permutations (delete x l)))) l)))
(display (permutations '(1 2 3))) (newline)
(define (count-change amount coins)
  (cond ((= amount 0) 1)
        ((or (< amount 0) (null? coins)) 0)
        (else (+ (count-change amount (cdr coins)) (count-change (- amount (car coins)) coins)))))
(display (count-change 50 '(50 25 10 5 1))) (newline)
(define (matrix-mul a b) (map (lambda (row) (apply map (lambda col (apply + (map * row col))) b)) a))
(display (matrix-mul '((1 2) (3 4)) '((5 6) (7 8)))) (newline)
(define (accumulate op init seq) (if (null? seq) init (op (car seq) (accumulate op init (cdr seq)))))
(display (accumulate + 0 (map (lambda (x) (* x x)) (iota 10 1)))) (newline)
(define (gcd2 a b) (if (= b 0) a (gcd2 b (remainder a b))))
(display (gcd2 1071 462)) (newline)
(define v (vector 5 3 8 1))
(display (sort v <)) (display (list-sort < '(3 2 1))) (newline)
(define (assoc-update alist k f d)
  (cond ((null? alist) (list (cons k (f d))))
        ((equal? (caar alist) k) (cons (cons k (f (cdar alist))) (cdr alist)))
        (else (cons (car alist) (assoc-update (cdr alist) k f d)))))
(define (word-freq words) (fold-left (lambda (acc w) (assoc-update acc w (lambda (n) (+ n 1)) 0)) '() words))
(display (word-freq '(the cat the dog the end))) (newline)
(define (range a b) (if (>= a b) '() (cons a (range (+ a 1) b))))
(display (map (lambda (n) (* n n)) (range 1 6))) (newline)
(display (let loop ((n 27) (steps 0)) (if (= n 1) steps (loop (if (even? n) (quotient n 2) (+ (* 3 n) 1)) (+ steps 1))))) (newline)
