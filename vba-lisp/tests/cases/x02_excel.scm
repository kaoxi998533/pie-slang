(set-cell! 1 1 "Name")
(set-cell! "B1" "Score")
(set-range! "A2" '(("Ann" 90) ("Bob" 75) ("Cy" 82.5)))
(display (list (cell 1 1) (cell "B1") (cell 2 2) (cell "B4"))) (newline)
(write (get-range "A1:B4")) (newline)
(display (apply + (get-range "B2:B4"))) (newline)
(set-range! "D1" '(1 2 3))
(display (get-range "D1:D3")) (newline)
(clear-range! "D1:D3")
(display (get-range "D1:D3")) (newline)
(display (null? (cell 9 9))) (newline)
(display (if (member "Data" (sheet-names)) #t #f)) (newline)
