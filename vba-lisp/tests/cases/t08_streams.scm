(define p (delay (begin (display "computing ") 42)))
(display (force p)) (display " ") (display (force p)) (newline)
(define (ints-from n) (cons-stream n (ints-from (+ n 1))))
(define (stream-take s n) (if (= n 0) '() (cons (stream-car s) (stream-take (stream-cdr s) (- n 1)))))
(display (stream-take (ints-from 1) 5)) (newline)
(define (stream-filter pred s)
  (if (pred (stream-car s))
      (cons-stream (stream-car s) (stream-filter pred (stream-cdr s)))
      (stream-filter pred (stream-cdr s))))
(define (sieve s)
  (cons-stream (stream-car s)
               (sieve (stream-filter (lambda (x) (not (= 0 (remainder x (stream-car s))))) (stream-cdr s)))))
(display (stream-take (sieve (ints-from 2)) 10)) (newline)
(display (force (make-promise 5))) (display (promise? p)) (display (force 7)) (newline)
(define-syntax my-delay (syntax-rules () ((_ e) (lambda () e))))
(display ((my-delay (+ 1 2)))) (newline)
(define r (delay-force (delay 'inner)))
(display (force r)) (newline)
