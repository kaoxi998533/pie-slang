; Excel only: integers beyond 32 bits use VBA's Decimal type (up to 28 digits)
(define (fact n) (if (= n 0) 1 (* n (fact (- n 1)))))
(display (fact 20)) (newline)
(display (fact 25)) (newline)
(display (expt 2 64)) (newline)
(display (* 99999 99999 99999)) (newline)
(display (+ (expt 2 62) 1)) (newline)
(display (- (expt 2 40))) (newline)
(display (quotient (expt 10 20) 7)) (newline)
