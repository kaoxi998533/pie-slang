(define-record-type point (make-point x y) point? (x point-x set-point-x!) (y point-y))
(define p (make-point 3 4))
(display (point-x p)) (display " ") (display (point-y p)) (newline)
(set-point-x! p 10)
(display (point-x p)) (newline)
(display (point? p)) (display (point? 5)) (newline)
(display p) (newline)
(define-record-type <account> (make-account owner balance) account? (owner account-owner) (balance account-balance set-account-balance!))
(define acc (make-account "Ann" 100))
(set-account-balance! acc (+ (account-balance acc) 50))
(display (account-balance acc)) (display (account? p)) (newline)
(define h (make-hash-table))
(hash-table-set! h 'a 1)
(hash-table-set! h "b" 2)
(hash-table-set! h '(1 2) 'list-key)
(display (list (hash-table-ref/default h 'a 0) (hash-table-ref/default h 'zz 0))) (newline)
(display (hash-table-ref h "b" (lambda () 'none))) (newline)
(display (hash-table-ref/default h (list 1 2) #f)) (newline)
(hash-table-update!/default h 'a (lambda (v) (+ v 100)) 0)
(display (hash-table-ref/default h 'a 0)) (newline)
(display (hash-table-count h)) (newline)
(hash-table-delete! h "b")
(display (hash-table-contains? h "b")) (newline)
(define counts (make-hash-table))
(for-each (lambda (w) (hash-table-update!/default counts w (lambda (c) (+ c 1)) 0)) '(a b a c a b))
(display (sort (hash-table->alist counts) (lambda (x y) (> (cdr x) (cdr y))))) (newline)
(display (hash-table-keys counts)) (display (hash-table-values counts)) (newline)
(display (hash-ref counts 'zz)) (display (hash-ref counts 'a)) (newline)
(display (guard (e (#t (condition/report-string e))) (hash-table-ref counts 'missing))) (newline)
(define ht2 (make-equal-hash-table))
(hash-table-set! ht2 1 'int)
(hash-table-set! ht2 1.0 'float)
(display (hash-table-count ht2)) (newline)
(display (guard (e (#t (condition/report-string e))) (point-x acc))) (newline)
