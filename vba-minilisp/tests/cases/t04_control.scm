; cond, let, and, or, begin, strings
(define (grade score)
  (cond ((>= score 90) "A")
        ((>= score 80) "B")
        ((>= score 60) "C")
        (else "F")))
(display (map grade '(95 85 70 10))) (newline)
(display (cond (#f 1) (42))) (newline)
(display (let ((a 3) (b 4)) (sqrt (+ (* a a) (* b b))))) (newline)
(define x 1)
(display (let ((x 10) (y x)) (list x y))) (newline)
(display x) (newline)
(display (and 1 2 3)) (newline)
(display (and 1 #f 3)) (newline)
(display (and)) (newline)
(display (or #f 5)) (newline)
(display (or #f #f)) (newline)
; and/or stop early: (car '()) is never evaluated
(display (or 1 (car '()))) (newline)
(display (and #f (car '()))) (newline)
(display (begin (display "a") (display "b") "c")) (newline)
(define greeting (string-append "Hello, " "World" "!"))
(display greeting) (newline)
(display (string-length greeting)) (newline)
(display (string-append "n = " (number->string 42))) (newline)
(display (string? greeting)) (newline)
(display "tab:\t| quote:\" backslash:\\ newline:\nend") (newline)
(display (list "a" "b")) (newline)
; a loop written as tail recursion
(define (count-down n)
  (if (> n 0)
      (begin (display n) (display " ") (count-down (- n 1)))
      (display "liftoff")))
(count-down 5) (newline)
