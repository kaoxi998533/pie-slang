; lists
(define nums '(1 2 3 4 5))
(display nums) (newline)
(display (car nums)) (newline)
(display (cdr nums)) (newline)
(display (cadr nums)) (newline)
(display (cons 0 nums)) (newline)
(display (list 1 (+ 1 1) "three" 'four)) (newline)
(display (length nums)) (newline)
(display (append '(1 2) '(3) '() '(4 5))) (newline)
(display (null? '())) (newline)
(display (null? nums)) (newline)
(display (list? nums)) (newline)
(display (list? 5)) (newline)
(display '()) (newline)
(display '(a (b c) ((d)))) (newline)
(display (quote (+ 1 2))) (newline)
; map, filter and reverse are written in Lisp itself (see Prelude)
(display (map (lambda (x) (* x x)) nums)) (newline)
(display (filter (lambda (x) (> x 2)) nums)) (newline)
(display (reverse nums)) (newline)
(display (map car '((a 1) (b 2)))) (newline)
; recursion over lists
(define (sum lst)
  (if (null? lst) 0 (+ (car lst) (sum (cdr lst)))))
(display (sum nums)) (newline)
(define (range a b)
  (if (>= a b) '() (cons a (range (+ a 1) b))))
(display (range 0 10)) (newline)
(display (equal? '(1 (2 3)) (list 1 (list 2 3)))) (newline)
(display (equal? '(1 2) '(1 2 3))) (newline)
(display (eq? 'a 'a)) (newline)
(display (equal? "abc" "abc")) (newline)
(display (symbol? 'a)) (newline)
(display (symbol? "a")) (newline)
(display (number? 1)) (newline)
